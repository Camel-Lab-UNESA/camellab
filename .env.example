# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site. Use your production domain on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Supabase → Connect → Transaction pooler, with the camellab_web role from supabase/setup.sql:
#   postgresql://camellab_web.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Don't add ?sslmode=… (it overrides the TLS settings in server/utils/auth.ts).
DATABASE_URL=
# Supabase → Database settings → SSL configuration → Download certificate. Paste the whole PEM.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# Confirmation emails on sign-up. Defaults to true; set false for local dev.
REQUIRE_EMAIL_VERIFICATION=true

# https://resend.com/api-keys (in dev, leaving this empty prints emails to the terminal)
RESEND_API_KEY=
# Must use a domain verified in Resend.
MAIL_FROM="Camellab <noreply@yourdomain.com>"

# GitHub repo the admin commits posts to. This must be the repo Vercel deploys.
GITHUB_REPO=
# Branch Vercel deploys.
GITHUB_BRANCH=main
# Fine-grained token with Contents: read and write for that repo. Server-only.
GITHUB_TOKEN=
